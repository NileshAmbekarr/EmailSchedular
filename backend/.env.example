# ============================================================================
# CORE INFRASTRUCTURE
# ============================================================================

DATABASE_URL=postgresql://user:password@host:5432/email_scheduler

# Standard Redis URL. For Upstash use the rediss:// connection string, NOT the
# REST URL. UPSTASH_REDIS_URL is still accepted as an alias.
REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379

# ============================================================================
# SECRETS  — generate with: openssl rand -hex 32
# ============================================================================

JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# AES-256-GCM key protecting SMTP passwords and DKIM private keys at rest.
# Rotating this makes existing stored credentials unreadable.
ENCRYPTION_KEY=

# Signs unsubscribe and click-tracking links. Defaults to JWT_SECRET if unset.
LINK_SECRET=

# ============================================================================
# GOOGLE OAUTH (optional — sign-in falls back to email/password if unset)
# ============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# SENDING
# ============================================================================

# ethereal | smtp | resend | ses
#   ethereal — development sink; captures mail and returns a preview URL
#   smtp     — your own server, configured per sender
#   resend   — HTTPS API, recommended for production
#   ses      — Amazon SES v2
EMAIL_PROVIDER=ethereal

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
# From the Resend dashboard. Required — unsigned webhooks are rejected.
RESEND_WEBHOOK_SECRET=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SES configuration set that publishes delivery events to SNS.
SES_CONFIGURATION_SET=

# ============================================================================
# THROUGHPUT
# ============================================================================

MAX_EMAILS_PER_HOUR_PER_SENDER=200
DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5
FANOUT_BATCH_SIZE=500

# A message stuck in `processing` longer than this is reclaimed on recovery.
STUCK_JOB_TIMEOUT_MS=600000
# Past-due messages older than this are expired rather than delivered late.
MAX_RECOVERY_LATENESS_MS=86400000

# ============================================================================
# REPUTATION GUARDS — campaigns auto-pause past these thresholds
# ============================================================================

MAX_COMPLAINT_RATE=0.001
MAX_BOUNCE_RATE=0.05
SOFT_BOUNCE_THRESHOLD=3

# ============================================================================
# SERVER
# ============================================================================

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Public URL of this API. Unsubscribe and tracking links are built from it, so
# it must be reachable from a recipient's mail client.
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Extra CORS origins, comma separated (e.g. Vercel preview deployments).
ALLOWED_ORIGINS=

# Set false on the API when running `npm run start:worker` as its own service.
# Render's background workers are paid-only, so leave this true on a free plan
# and the queue workers run inside the API process.
RUN_WORKER_IN_API=true

# Port the standalone worker's health endpoint binds to. Defaults to PORT+1 so
# the API and worker can share a machine. On platforms that require a service to
# bind their injected $PORT (Render web services), set this equal to PORT.
WORKER_PORT=
